RUNTIME_RUNNER_TOKEN=
RUNTIME_DATA_DIR=/srv/jojo-runtime
RUNTIME_CONTROL_PORT=8791
RUNTIME_PUBLIC_PORT=8790
RUNTIME_MAX_JOBS=2
HOSTING_BASE_DOMAIN=apps.example.net
HOSTING_PUBLIC_IP=REPLACE_WITH_WORKER_IP
HOSTING_MAX_SITES=100
BUILD_IMAGE=node:22-alpine

# Optional: explicit operator proxy for npm installs only; never passed to build scripts.
BUILD_INSTALL_PROXY=
# Optional public enterprise CA bundle, read-only during installation; TLS stays verified.
BUILD_INSTALL_CA_FILE=
