# Studio process. Copy to .env.local; never commit actual credentials.
DATABASE_URL=postgresql://studio:REPLACE@127.0.0.1:5432/studio
JOJO_AUTH_JWT_SECRET=
# Match the developer portal's HS256 signing secret (at least 32 characters).
JOJO_AUTH_ISSUER=
JOJO_AUTH_AUDIENCE=
JOJO_INITIAL_CREDITS=0
STUDIO_PUBLIC_ORIGIN=https://ai.cashpay-all.com
NEXT_PUBLIC_AUTH_PORTAL_URL=https://developer.cashpay-all.com
# Generate once with: openssl rand -base64 32. Back up securely; rotation requires re-encryption.
INTEGRATION_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OAuth callback: https://ai.cashpay-all.com/api/integrations/github/callback
# Dedicated project database cluster ONLY, never the CashPay financial cluster.
PROJECT_DATABASE_ADMIN_URL=
# Control APIs are private. Use SSH tunnels/VPN when workers are remote.
RUNTIME_RUNNER_URL=http://127.0.0.1:8791
RUNTIME_RUNNER_TOKEN=
ANDROID_RUNNER_URL=http://127.0.0.1:8788
ANDROID_RUNNER_TOKEN=
ANDROID_PUBLIC_ORIGIN=https://ai.cashpay-all.com/android
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Coding engine. API key is server-only; ChatGPT login is not API authentication.
OPENAI_API_KEY=
# Choose an available coding model with Responses API access in your OpenAI project.
# No hardcoded model fallback: model availability and deprecations change over time.
OPENAI_CODEX_MODEL=
OPENAI_IMAGE_MODEL=
